FROM golang:1.26 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/agent ./cmd/agent

# The root variant, not :nonroot: the incus-socket proxy device's socket is
# root-owned with mode 0644, so only uid 0 can connect to it. It lives in /dev,
# which Incus provides, so the image needs no directory of its own for it.
FROM gcr.io/distroless/static-debian12
# Links the GHCR package to this repo, so it shows on the repo page and
# inherits the repo's access settings.
LABEL org.opencontainers.image.source=https://github.com/ehharvey/homelab-ops
COPY --from=builder /out/agent /agent
ENTRYPOINT ["/agent"]
