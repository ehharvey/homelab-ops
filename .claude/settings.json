{
  "permissions": {
    "allow": [
      "Bash(scripts/finding.sh *)"
    ],
    "ask": [
      "Bash(gh issue close *)",
      "Bash(gh pr edit *)"
    ]
  },
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "issue-worker",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/finding-noticed.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/finding-count.sh"
          }
        ]
      }
    ]
  }
}
