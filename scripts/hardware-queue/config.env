# Defaults for the validate/hardware queue (#664). job.sh sources this file,
# then /etc/hardware-queue/setup.env (written by setup.sh on every run), then
# /etc/hardware-queue/config.env (the operator's own overrides, which setup.sh
# creates once and never rewrites). Later files win. Plain assignments only:
# job.sh checks the values it depends on before doing anything.

# The repository whose PRs into main are queued.
HQ_REPO=ehharvey/homelab-ops
HQ_CLONE_URL=https://github.com/ehharvey/homelab-ops.git
# The one login with write access. Anyone else with push, maintain or admin
# on /collaborators and nothing runs: the picked PR gets `error` instead.
HQ_OPERATOR=ehharvey
# PR authors that run, spelled as `gh pr list` reports them: a bot is
# app/<login without [bot]>. Space-separated.
HQ_AUTHORS="ehharvey app/dependabot app/github-actions"

# The run: VALIDATE_OS=$HQ_BACKEND run.sh --group $HQ_GROUPS --strict
# --allow-skip $HQ_ALLOW_SKIP. job.sh refuses `github` in the groups and
# `host-os` in the allow-list.
HQ_BACKEND=incusos
HQ_GROUPS=incus,incus-vm
# incus-cluster: homelab-host is a one-member cluster, so the targeted create
# in incuslocal-round-trips-instances-over-unix-socket.sh can never run there.
# Add a tag only with a recorded reason.
HQ_ALLOW_SKIP=incus-cluster

# Seconds. Poll GitHub every HQ_POLL_INTERVAL while idle; while a run is going,
# check its PR every HQ_WATCH_INTERVAL and stop it if the head moved or the PR
# closed. A run is stopped after HQ_TIMEOUT. An `error` head runs again once
# its status is HQ_ERROR_BACKOFF old. A stopped run gets TERM, and KILL after
# HQ_KILL_GRACE.
HQ_POLL_INTERVAL=120
HQ_WATCH_INTERVAL=60
HQ_TIMEOUT=7200
HQ_ERROR_BACKOFF=1800
HQ_KILL_GRACE=120

# The commit status the job posts, and the warning window before the token
# expires (in days), inside which every description says when.
HQ_CONTEXT=validate/hardware
HQ_TOKEN_WARN_DAYS=30

# On the instance. The token file is written by setup.sh, mode 0400.
HQ_STATE_DIR=/var/lib/hardware-queue
HQ_TOKEN_FILE=/etc/hardware-queue/token
# Run logs kept, one per SHA, newest first.
HQ_LOG_KEEP=50

# The Incus server the suite drives, and the job's own VM there. The sweep
# never touches HQ_VM_NAME, and job.sh refuses a name the sweep would match.
HQ_INCUS_REMOTE=homelab-host
HQ_INCUS_PROJECT=default
HQ_VM_NAME=hardware-queue

# The incus-bridge compose service (docker-compose.yml), which gives the three
# unix-socket scripts VALIDATE_INCUS_SOCKET. setup.sh writes the address and
# the server certificate's name into setup.env. HQ_BRIDGE=0 turns it off.
HQ_BRIDGE=1
HQ_BRIDGE_HOST_ADDR=
HQ_BRIDGE_SERVER_NAME=pc0
