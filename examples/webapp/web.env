# The web app's scalar settings (docs/Deployment.md § Settings): KEY=VALUE,
# the same names as the env vars. An env var of the same name overrides a
# line here, even when set to "". An unknown key stops startup.

# The host:port nodes dial to reach the tunnel, baked into every node's seed.
# Use a DNS name, so the web app can move hosts without reflashing a node.
# Required while operator-peers lists anyone.
WIREGUARD_ENDPOINT=webapp.example.net:51820

# The fleet config repo. Never put credentials in the URL (startup refuses
# it); git credentials are #218's, under secrets/.
CONFIG_REPO_URL=https://github.com/you/fleet.git
CONFIG_REPO_REF=main
CONFIG_SYNC_INTERVAL=5m

# Network addressing (docs/Config Schema.md, `kind: Network`). The repo
# is assumed public, so a Network in it carries only its name, addressed from
# a file of kind: Network documents. Only for a private repo may git carry the
# addressing instead.
# NETWORK_ADDRESSING_PATH=/var/lib/homelab-ops/networks.yaml
# CONFIG_REPO_PRIVATE=true

# Keep the store across restarts: mount a volume and point at a file on it.
# Unset, the store is in memory.
# STORE_PATH=/var/lib/homelab-ops/web.db

# Server-side image builds: the base IncusOS image, outside this directory.
# BASE_IMAGE_PATH=/var/lib/homelab-ops/incusos-base.img
