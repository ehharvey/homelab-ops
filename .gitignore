venv/
__pycache__/
*.pyc
.terragrunt-cache/
.terraform/
*.tfstate
*.tfstate.*
.devcontainer/host-setup/.trust-token

# Go build artifacts
bin/
# `go build ./cmd/<name>` with no -o drops the binary in the repo root rather
# than bin/ (where `make build` puts it), so every cmd/ binary is ignored at the
# root. A new cmd/<name> needs its own /<name> line here. Keep each entry
# root-anchored: an unanchored `agent` would also match the tracked cmd/agent.
/agent
/bootstrap
/web
/validate-tunnel-harness
/validate-incuslocal-harness

# Per-issue git worktrees (scripts/worktree.sh, #252)
.claude/worktrees/

# Bootstrap CLI generated artifacts (certs, seeds, images) — never commit private keys
bootstrap-output/

# Locally downloaded base IncusOS images, used with scripts/validate-issue-5.sh
*.img
